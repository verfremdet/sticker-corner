# Bot-Token aus dem Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=
# ID des Sticker-Channels (Rechtsklick auf den Channel → ID kopieren)
CHANNEL_ID=
# Port, nur lokal; nginx leitet stickers.finalstate.de hierher
PORT=8790
# Ordner für Bilder und stickers.json
DATA_DIR=/srv/stickercorner
